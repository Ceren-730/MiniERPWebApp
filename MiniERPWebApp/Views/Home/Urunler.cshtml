@model List<MiniERPWebApp.Models.Urun>

<h1>Ürün Listesi</h1>

<table border="1">
    <tr>
        <th>Ürün ID</th>
        <th>Ürün Adı</th>
        <th>Kategori</th>
        <th>Fiyat</th>
        <th>Stok</th>
    </tr>

    @foreach (var urun in Model)
    {
        <tr>
            <td>@urun.UrunID</td>
            <td>@urun.UrunAdi</td>
            <td>@urun.Kategori</td>
            <td>@urun.Fiyat TL</td>
            <td>@urun.Stok</td>
        </tr>
    }
</table>